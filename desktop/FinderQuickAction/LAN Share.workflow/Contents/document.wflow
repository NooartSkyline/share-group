				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>set -e
SHARE=""
if [ -x "$HOME/LANShare/bin/share" ]; then
  SHARE="$HOME/LANShare/bin/share"
elif command -v share &gt;/dev/null 2&gt;&amp;1; then
  SHARE="$(command -v share)"
fi
if [ -z "$SHARE" ]; then
  echo "ยังไม่มีคำสั่ง share — รัน desktop/FinderQuickAction/install.sh ก่อน" &gt;&amp;2
  exit 1
fi
exec "$SHARE" send "$@"
</string>
